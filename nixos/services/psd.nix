{
  # profile-sync-daemon: переносит профили браузеров в tmpfs и синхронизирует
  # обратно на диск по таймеру. Пакет сам в systemPackages не нужен — модуль
  # тянет его как зависимость сервиса.
  services.psd = {
    enable = true;
    # По умолчанию 1h; при 15m меньше данных теряется при внезапном выключении,
    # но чаще запись на диск
    resyncTimer = "15m";
  };
}
