      "--dpi-desync-repeats=11"
      "--dpi-desync-fake-quic=${zdy}/bin/quic_initial_www_google_com.bin"
      "--new"
      "--filter-udp=19294-19344,50000-50100"
      "--filter-l7=discord,stun"
      "--dpi-desync=fake"
      "--dpi-desync-fake-discord=${zdy}/bin/ACTIVE_DISCORD_UDP.bin"
      "--dpi-desync-fake-stun=${zdy}/bin/ACTIVE_DISCORD_UDP.bin"
      "--dpi-desync-repeats=6"
      "--new"
      "--filter-tcp=2053,2083,2087,2096,8443"
      "--hostlist-domains=discord.media"
      "--dpi-desync=fake,multisplit"
      "--dpi-desync-split-seqovl=681"
      "--dpi-desync-split-pos=1"
      "--dpi-desync-fooling=ts"
      "--dpi-desync-repeats=8"
      "--dpi-desync-split-seqovl-pattern=${zdy}/bin/tls_clienthello_www_google_com.bin"
      "--dpi-desync-fake-tls=${zdy}/bin/tls_clienthello_www_google_com.bin"
      "--new"
      "--filter-tcp=443"
      "--hostlist=${zdy}/lists/list-google.txt"
      "--ip-id=zero"
      "--dpi-desync=fake,multisplit"
      "--dpi-desync-split-seqovl=681"
      "--dpi-desync-split-pos=1"
      "--dpi-desync-fooling=ts"
      "--dpi-desync-repeats=8"
      "--dpi-desync-split-seqovl-pattern=${zdy}/bin/tls_clienthello_www_google_com.bin"
